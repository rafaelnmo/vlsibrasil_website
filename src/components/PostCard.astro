---
import { excerpt, formatDate, layerOf, readingTime, slugify, type Post } from '../lib/posts';

interface Props {
  post: Post;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const { title, date, categories, cover, draft } = post.data;
const category = categories[0];
---

<article class:list={['card', { featured }]}>
  <a href={`/posts/${post.id}/`} class="cover" tabindex="-1" aria-hidden="true">
    {
      cover ? (
        <img src={cover} alt="" loading={featured ? 'eager' : 'lazy'} />
      ) : (
        <div class="cover-fallback" data-layer={category ? layerOf(category) : 'm1'} />
      )
    }
  </a>
  <div class="body">
    <div class="meta">
      {
        category && (
          <a class="chip" data-layer={layerOf(category)} href={`/categories/${slugify(category)}/`}>
            {category}
          </a>
        )
      }
      {draft && <span class="chip" data-layer="poly">rascunho</span>}
      <span class="mono muted">{readingTime(post.body)} min</span>
    </div>
    <h3><a href={`/posts/${post.id}/`}>{title}</a></h3>
    <p class="excerpt">{excerpt(post, featured ? 260 : 150)}</p>
    <time class="mono muted" datetime={date.toISOString()}>{formatDate(date)}</time>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--brand) 60%, var(--border));
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }
  .cover {
    display: block;
    aspect-ratio: 1.9;
    overflow: hidden;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .card:hover .cover img {
    transform: scale(1.03);
  }
  .cover-fallback {
    width: 100%;
    height: 100%;
    --c: var(--layer-m1);
    background:
      repeating-linear-gradient(45deg, color-mix(in srgb, var(--c) 18%, transparent) 0 2px, transparent 2px 12px),
      var(--surface-2);
  }
  .cover-fallback[data-layer='m2'] { --c: var(--layer-m2); }
  .cover-fallback[data-layer='m3'] { --c: var(--layer-m3); }
  .cover-fallback[data-layer='poly'] { --c: var(--layer-poly); }
  .cover-fallback[data-layer='diff'] { --c: var(--layer-diff); }
  .cover-fallback[data-layer='via'] { --c: var(--layer-via); }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 1.25rem 1.25rem;
    flex: 1;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .muted {
    color: var(--muted);
  }
  h3 {
    font-size: 1.25rem;
  }
  /* o link do título cobre o card inteiro */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .meta a {
    position: relative;
    z-index: 1;
  }
  .excerpt {
    color: var(--muted);
    font-size: 0.9375rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  time {
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .featured {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
  }
  .featured .cover {
    aspect-ratio: auto;
    min-height: 100%;
    border-bottom: 0;
    border-right: 1px solid var(--border);
  }
  .featured .body {
    padding: clamp(1.25rem, 3vw, 2.25rem);
    gap: 0.9rem;
    justify-content: center;
  }
  .featured h3 {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }
  .featured .excerpt {
    font-size: 1rem;
    -webkit-line-clamp: 5;
  }
  .featured time {
    margin-top: 0.5rem;
  }
  @media (max-width: 800px) {
    .featured {
      grid-template-columns: 1fr;
    }
    .featured .cover {
      aspect-ratio: 1.9;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
  }
</style>
