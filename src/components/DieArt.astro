---
// Ilustração de um "die": anel de pads, linhas de standard cells, macros e
// rotas que vão sendo desenhadas. Gerada no build com um gerador pseudoaleatório
// fixo, então é sempre igual.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

const S = 400;
const pads = Array.from({ length: 13 }, (_, i) => 44 + i * 24.3);

const core = { x: 64, y: 64, w: 272, h: 272 };
const macros = [
  { x: 72, y: 72, w: 96, h: 76 },
  { x: 236, y: 252, w: 92, h: 76 },
];
const inMacro = (x: number, y: number, w: number, h: number) =>
  macros.some((m) => x < m.x + m.w + 4 && x + w > m.x - 4 && y < m.y + m.h + 4 && y + h > m.y - 4);

const cells: { x: number; y: number; w: number; layer: number }[] = [];
for (let y = core.y + 4; y < core.y + core.h - 16; y += 20) {
  let x = core.x + 4;
  while (x < core.x + core.w - 10) {
    const w = 6 + Math.round(rand() * 18);
    if (x + w > core.x + core.w - 4) break;
    if (!inMacro(x, y, w, 14) && rand() > 0.12) cells.push({ x, y, w, layer: Math.floor(rand() * 4) });
    x += w + 2;
  }
}

// rotas manhattan: horizontais em M1, verticais em M2
const routes = [
  'M44 108 H200 V172 H300',
  'M168 110 H260 V84 H356',
  'M44 220 H120 V300 H220',
  'M140 356 V236 H232 V128',
  'M356 196 H284 V236 H176',
  'M260 44 V164 H330',
  'M84 356 V316 H200 V250',
];
const vias = [
  [200, 108], [200, 172], [260, 110], [260, 84], [120, 220], [120, 300],
  [140, 236], [232, 236], [232, 128], [284, 196], [284, 236], [260, 164], [84, 316], [200, 316],
];
---

<svg class="die" viewBox={`0 0 ${S} ${S}`} role="img" aria-label="Ilustração de um chip: células, macros e rotas">
  <rect class="die-edge" x="20" y="20" width="360" height="360" rx="6"></rect>
  {
    pads.map((p) => (
      <>
        <rect class="pad" x={p - 6} y="26" width="12" height="12" />
        <rect class="pad" x={p - 6} y="362" width="12" height="12" />
        <rect class="pad" x="26" y={p - 6} width="12" height="12" />
        <rect class="pad" x="362" y={p - 6} width="12" height="12" />
      </>
    ))
  }
  <rect class="core" x={core.x} y={core.y} width={core.w} height={core.h}></rect>
  {cells.map((c) => <rect class={`cell l${c.layer}`} x={c.x} y={c.y} width={c.w} height="14" />)}
  {
    macros.map((m, i) => (
      <g>
        <rect class="macro" x={m.x} y={m.y} width={m.w} height={m.h} />
        <text class="macro-label" x={m.x + 8} y={m.y + 16}>
          {i === 0 ? 'SRAM_0' : 'PLL'}
        </text>
      </g>
    ))
  }
  {
    routes.map((d, i) => (
      <path class={`route r${i % 3}`} d={d} pathLength="1" style={`animation-delay:${i * 0.45}s`} />
    ))
  }
  {vias.map(([x, y]) => <rect class="via" x={x - 3} y={y - 3} width="6" height="6" />)}
</svg>

<style>
  .die {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .die-edge {
    fill: var(--surface);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .pad {
    fill: color-mix(in srgb, var(--layer-m3) 55%, transparent);
  }
  .core {
    fill: none;
    stroke: color-mix(in srgb, var(--brand) 40%, transparent);
    stroke-dasharray: 4 4;
  }
  .cell {
    fill: color-mix(in srgb, var(--muted) 18%, transparent);
    stroke: color-mix(in srgb, var(--muted) 30%, transparent);
    stroke-width: 0.5;
  }
  .cell.l0 {
    fill: color-mix(in srgb, var(--layer-diff) 22%, transparent);
  }
  .cell.l1 {
    fill: color-mix(in srgb, var(--layer-poly) 16%, transparent);
  }
  .macro {
    fill: color-mix(in srgb, var(--layer-m2) 10%, var(--surface));
    stroke: color-mix(in srgb, var(--layer-m2) 55%, transparent);
  }
  .macro-label {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: var(--muted);
  }
  .route {
    fill: none;
    stroke-width: 3;
    stroke-linecap: square;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: route 7s ease-in-out infinite;
  }
  .route.r0 {
    stroke: var(--brand);
  }
  .route.r1 {
    stroke: var(--layer-m1);
  }
  .route.r2 {
    stroke: var(--layer-m2);
  }
  .via {
    fill: var(--text);
    opacity: 0.75;
  }
  @keyframes route {
    0% {
      stroke-dashoffset: 1;
    }
    35%,
    85% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: -1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .route {
      stroke-dashoffset: 0;
    }
  }
</style>
