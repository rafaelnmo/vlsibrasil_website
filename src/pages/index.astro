---
import Base from '../layouts/Base.astro';
import DieArt from '../components/DieArt.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { getPosts, groupBy, layerOf } from '../lib/posts';

const posts = await getPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const latest = posts.filter((p) => p !== featured).slice(0, 6);
const categories = groupBy(posts, 'categories');

// Etapas do fluxo digital — cada uma vira link quando houver categoria com esse nome.
const flow = ['RTL', 'Simulação', 'Síntese', 'STA', 'Floorplan', 'Place & Route', 'Verificação física', 'Tapeout'];
---

<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow">// blog de microeletrônica em português</p>
        <h1>
          Do RTL ao <span class="grad">silício</span>, explicado sem mistério.
        </h1>
        <p class="lead">
          Tutoriais práticos sobre o fluxo de projeto digital, formatos de arquivo, PDKs e ferramentas de EDA
          — proprietárias e open source — para quem quer projetar chips no Brasil.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href="/posts/">Ler os artigos →</a>
          <a class="btn" href="/about/">Sobre o projeto</a>
        </div>
        <dl class="stats mono">
          <div><dt>artigos</dt><dd>{posts.length}</dd></div>
          <div><dt>categorias</dt><dd>{categories.length}</dd></div>
          <div><dt>idioma</dt><dd>pt-BR</dd></div>
        </dl>
      </div>
      <div class="hero-art">
        <DieArt />
      </div>
    </div>
  </section>

  <section class="flow-strip" aria-label="Etapas do fluxo de projeto digital">
    <div class="container flow mono">
      {
        flow.map((step, i) => (
          <>
            <span class="step">{step}</span>
            {i < flow.length - 1 && <span class="arrow">→</span>}
          </>
        ))
      }
    </div>
  </section>

  {
    featured && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <h2>Em destaque</h2>
          </div>
          <PostCard post={featured} featured />
        </div>
      </section>
    )
  }

  <div class="container">
    <AdSlot slot="home-banner" />
  </div>

  {
    latest.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <h2>Últimos artigos</h2>
            <a href="/posts/">ver todos →</a>
          </div>
          <div class="grid-posts">
            {latest.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Explore por camada</h2>
        <a href="/categories/">todas as categorias →</a>
      </div>
      <div class="layers">
        {
          categories.map((c) => (
            <a class="layer" data-layer={layerOf(c.name)} href={`/categories/${c.slug}/`}>
              <span class="swatch" />
              <span class="layer-name">{c.name}</span>
              <span class="mono layer-count">{String(c.posts.length).padStart(2, '0')}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(40px, 8vw, 96px) clamp(32px, 6vw, 64px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    margin-top: 1rem;
  }
  .grad {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    color: var(--muted);
    max-width: 52ch;
  }
  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .stats {
    display: flex;
    gap: 2rem;
    margin: 2.5rem 0 0;
  }
  .stats dt {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .stats dd {
    margin: 0.15rem 0 0;
    font-size: 1.25rem;
    color: var(--text);
  }
  .hero-art {
    max-width: 460px;
    justify-self: center;
    width: 100%;
  }

  .flow-strip {
    border-block: 1px solid var(--border);
    background: var(--surface);
  }
  .flow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 1rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .step {
    white-space: nowrap;
    color: var(--muted);
  }
  .arrow {
    color: var(--brand);
  }

  .layers {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 0.75rem;
  }
  .layer {
    --c: var(--brand);
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s;
  }
  .layer:hover {
    border-color: var(--c);
  }
  .layer[data-layer='m1'] { --c: var(--layer-m1); }
  .layer[data-layer='m2'] { --c: var(--layer-m2); }
  .layer[data-layer='m3'] { --c: var(--layer-m3); }
  .layer[data-layer='poly'] { --c: var(--layer-poly); }
  .layer[data-layer='diff'] { --c: var(--layer-diff); }
  .layer[data-layer='via'] { --c: var(--layer-via); }
  .swatch {
    width: 28px;
    height: 28px;
    border-radius: 4px;
    border: 1.5px solid var(--c);
    background: repeating-linear-gradient(45deg, var(--c) 0 2px, transparent 2px 6px);
    opacity: 0.85;
  }
  .layer-name {
    font-weight: 600;
  }
  .layer-count {
    margin-left: auto;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-art {
      max-width: 320px;
    }
  }
</style>
