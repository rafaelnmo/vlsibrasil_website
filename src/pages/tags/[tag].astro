---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, groupBy, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  return groupBy(await getPosts(), 'tags').map((t) => ({
    params: { tag: t.slug },
    props: { name: t.name, posts: t.posts },
  }));
}

const { name, posts } = Astro.props as { name: string; posts: Post[] };
---

<Base title={`#${name}`} description={`Artigos do VLSI Brasil com a tag ${name}.`}>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">// tag</p>
      <h1>#{name}</h1>
      <p>{posts.length} {posts.length === 1 ? 'artigo' : 'artigos'} · <a href="/categories/">ver categorias e tags</a></p>
    </header>
    <div class="grid-posts">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</Base>

<style>
  .page-head a {
    color: var(--brand);
  }
</style>
